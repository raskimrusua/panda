---
const year = new Date().getFullYear()
---

<footer class="mt-24 border-t border-warm-cream/60 bg-warm-cream/20">
  <div class="mx-auto max-w-6xl px-4 py-10 md:px-6 md:py-14">
    <div class="grid gap-8 md:grid-cols-4">
      <div class="md:col-span-2">
        <a href="/" class="text-lg font-semibold text-highland-green">
          Panda<span class="text-panda-leaf">.</span>
        </a>
        <p class="mt-2 max-w-md text-sm text-rich-earth/70">
          Plan, log, and grow your horticulture farm. Built for Kenyan
          smallholders. Inspired by SHEP PLUS. Sister product to
          <a class="underline hover:text-highland-green" href="https://shira.farm">Shira</a>.
        </p>
      </div>

      <div>
        <h3 class="mb-2 text-sm font-semibold text-rich-earth">Product</h3>
        <ul class="space-y-1 text-sm">
          <li><a href="/features" class="text-rich-earth/70 hover:text-highland-green">Features</a></li>
          <li><a href="/pricing" class="text-rich-earth/70 hover:text-highland-green">Pricing</a></li>
          <li><a href="/faq" class="text-rich-earth/70 hover:text-highland-green">FAQ</a></li>
          <li><a href="https://app.panda.shira.farm" class="text-rich-earth/70 hover:text-highland-green">Open the app</a></li>
        </ul>
      </div>

      <div>
        <h3 class="mb-2 text-sm font-semibold text-rich-earth">Company</h3>
        <ul class="space-y-1 text-sm">
          <li><a href="/contact" class="text-rich-earth/70 hover:text-highland-green">Contact</a></li>
          <li><a href="https://shira.farm" class="text-rich-earth/70 hover:text-highland-green">Shira (sister)</a></li>
          <li><span class="text-rich-earth/50">Pilot — Meru &amp; Kirinyaga, 2026</span></li>
        </ul>
      </div>

      <div>
        <h3 class="mb-2 text-sm font-semibold text-rich-earth">Legal</h3>
        <ul class="space-y-1 text-sm">
          <li><a href="/terms" class="text-rich-earth/70 hover:text-highland-green">Terms of Service</a></li>
          <li><a href="/privacy" class="text-rich-earth/70 hover:text-highland-green">Privacy Policy</a></li>
          <li><a href="/cookies" class="text-rich-earth/70 hover:text-highland-green">Cookie Policy</a></li>
          <li><span class="text-rich-earth/50">Kenya DPA 2019</span></li>
        </ul>
      </div>
    </div>

    <div class="mt-8 border-t border-warm-cream/60 pt-6 text-xs text-rich-earth/50">
      © {year} Upstate Web Co. Built in Nairobi, Kenya.
    </div>
  </div>
</footer>
