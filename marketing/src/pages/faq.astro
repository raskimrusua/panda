---
import PublicLayout from '@/layouts/PublicLayout.astro'
import Hero from '@/components/Hero.astro'
import FAQAccordion from '@/components/FAQAccordion'
import { faq } from '../../content/faq'
---

<PublicLayout title="FAQ — Panda" description="Honest answers about what Panda is, what's missing, and what's coming.">
  <Hero
    eyebrow="FAQ"
    title="Honest answers."
    subtitle="What Panda is, what's missing, what's coming. We update this as the pilot teaches us things."
  />

  <section class="mx-auto max-w-3xl px-4 py-12 md:px-6 md:py-16">
    <FAQAccordion items={faq} client:load />
  </section>
</PublicLayout>
