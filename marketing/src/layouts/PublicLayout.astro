---
import '@/styles/global.css'
import Navbar from '@/components/Navbar'
import Footer from '@/components/Footer.astro'

export interface Props {
  title?: string
  description?: string
  ogImage?: string
}

const {
  title = 'Panda — Plan, log, and grow your horticulture farm.',
  description = 'A Kenyan-built planning + logging tool for tomato, kale, and 15 other crops. Inspired by SHEP PLUS. Works offline. Bilingual EN / SW.',
  ogImage = '/og-image.png',
} = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="preconnect"
      href="https://fonts.googleapis.com"
    />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <!-- Structured data (JSON-LD) — Rule 78: AI agent commerce + rich results -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@graph': [
          {
            '@type': 'Organization',
            '@id': 'https://panda.shira.farm/#org',
            name: 'Panda',
            url: 'https://panda.shira.farm',
            description,
            email: 'hello@panda.shira.farm',
            slogan: 'Plan, log, and grow your horticulture farm.',
          },
          {
            '@type': 'WebSite',
            '@id': 'https://panda.shira.farm/#website',
            url: 'https://panda.shira.farm',
            name: 'Panda — Farm Planner',
            publisher: { '@id': 'https://panda.shira.farm/#org' },
            potentialAction: {
              '@type': 'SearchAction',
              target: { '@type': 'EntryPoint', urlTemplate: 'https://panda.shira.farm/?q={search_term_string}' },
              'query-input': 'required name=search_term_string',
            },
          },
          {
            '@type': 'SoftwareApplication',
            '@id': 'https://panda.shira.farm/#app',
            name: 'Panda — Farm Planner',
            applicationCategory: 'BusinessApplication',
            operatingSystem: 'Android, iOS, Web',
            url: 'https://panda-pwa.pages.dev',
            offers: { '@type': 'Offer', price: '0', priceCurrency: 'KES', description: 'Free Mkulima tier' },
          },
        ],
      })}
    />
  </head>
  <body class="font-sans">
    <Navbar client:load />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>