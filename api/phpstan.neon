includes:
    - ./vendor/larastan/larastan/extension.neon
parameters:
    paths: [app, config, routes, tests]
    level: 6
    excludePaths: [./bootstrap/cache/*]
    ignoreErrors:
        # Pest's TestCall macros (getJson, postJson, etc.) and $this->property in
        # beforeEach blocks aren't statically resolvable — standard Pest+PHPStan
        # friction. Scoped to tests/ only.
        - identifier: method.notFound
          path: tests/*
        - identifier: property.notFound
          path: tests/*
        # Pest's expectation chain ($x->and(...)) uses an unresolvable template.
        - message: '#Unable to resolve the template type TAndValue in call to method Pest\\Expectation#'
          path: tests/*
        # Eloquent date casts return Carbon — Larastan can't infer through accessor.
        # Resources call ->toDateString() on cast date; safe at runtime.
        - message: '#Cannot call method toDateString\(\) on string#'
