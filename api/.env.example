APP_NAME=Panda
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Nairobi
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database (Postgres only — no MySQL/SQLite in production)
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=panda_local
DB_USERNAME=panda
DB_PASSWORD=changeme

# Session + cache + queue (Redis-backed)
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=redis
CACHE_PREFIX=panda

QUEUE_CONNECTION=redis
HORIZON_PATH=horizon

# Redis (single instance, multiple DB indexes — see skill-laravel-horizon-queue)
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_QUEUE_DB=1
REDIS_SESSION_DB=2

# Mail (Resend in prod; log in dev)
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@panda.shira.farm"
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=

# Disease detection — switch to `kindwise` once an API key is provisioned.
CROP_HEALTH_PROVIDER=mock
KINDWISE_API_KEY=
KINDWISE_API_URL=https://crop.kindwise.com/api/v1
KINDWISE_TIMEOUT=20

# Storage (R2 default — toggleable to s3 per skill-laravel-storage-toggle)
STORAGE_BACKEND=r2
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com
R2_BUCKET=panda-media
R2_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=

# Disease AI (mock in P1–P4, real Crop.health from Kindwise in P5)
DISEASE_AI_PROVIDER=mock
CROP_HEALTH_API_KEY=
CROP_HEALTH_MAX_MONTHLY_KES=20000

# Sentry
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# Sanctum (Panda issues its own tokens — standalone, NOT shared with Shira)
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,localhost:8000,127.0.0.1,127.0.0.1:8000

# M-Pesa (defer to P5)
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_ENV=sandbox
