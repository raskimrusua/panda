# =============================================================================
# Panda — Production .env template
# Copy to /srv/panda/.env on the server and fill in the gaps marked TODO.
# Never commit a real .env. Never paste real values into this template file.
# =============================================================================

APP_NAME=Panda
APP_ENV=production
APP_KEY=                                   # TODO: generate with `php artisan key:generate --show`
APP_DEBUG=false
APP_URL=https://api.panda.shira.farm
APP_TIMEZONE=Africa/Nairobi
APP_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=warning

# --- Database (shared Postgres on Shira's CX22) ---
DB_CONNECTION=pgsql
DB_HOST=farmcore_db                        # docker DNS name on farmcore_network
DB_PORT=5432
DB_DATABASE=panda_production
DB_USERNAME=panda
DB_PASSWORD=                               # TODO: ops sets via openssl rand -base64 24

# --- Redis (shared with Shira; uses indices 5 + 6) ---
REDIS_HOST=farmcore_redis
REDIS_PORT=6379
REDIS_PASSWORD=                            # TODO: paste Shira's REDIS_PASSWORD verbatim
REDIS_DB=5
REDIS_QUEUE_DB=6

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=43200

# --- Sanctum auth ---
SANCTUM_STATEFUL_DOMAINS=panda.shira.farm

# --- Storage (R2 default; can flip to S3 later via STORAGE_BACKEND) ---
FILESYSTEM_DISK=local
# When R2 wired:
# FILESYSTEM_DISK=r2
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_BUCKET=panda-media
# AWS_DEFAULT_REGION=auto
# AWS_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# AWS_USE_PATH_STYLE_ENDPOINT=true

# --- Disease AI (mock through P4; flip to crop_health when key arrives) ---
DISEASE_AI_PROVIDER=mock
# CROP_HEALTH_API_KEY=
# CROP_HEALTH_MAX_MONTHLY_KES=20000

# --- Sentry (optional; only forwards if DSN set, no-op otherwise) ---
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Mail (Resend, shared with Shira) ---
MAIL_MAILER=resend
RESEND_API_KEY=                            # TODO: reuse Shira's RESEND_API_KEY
MAIL_FROM_ADDRESS=noreply@panda.shira.farm
MAIL_FROM_NAME="Panda"

# --- Filament admin gate (superuser-only; first user via tinker) ---
FILAMENT_PATH=admin
