# Panda PWA — local dev defaults. Copy to .env.local and edit.

# Backend API base. Local: http://localhost:8000  Prod: https://api.panda.shira.farm
VITE_API_URL=http://localhost:8000

# Sentry browser DSN (optional, leave blank for local).
VITE_SENTRY_DSN=

# Google OAuth client id (Google Cloud Console > OAuth 2.0 Client ID, type Web).
# Public by design — ships in the JS bundle; the API verifies the credential audience.
VITE_GOOGLE_CLIENT_ID=
